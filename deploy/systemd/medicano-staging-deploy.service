# Deploy do staging: segue a main (só commits com CI verde).
# Instalação: deploy/README.md, seção 6. Ajuste User= se o usuário não for marcos
# (precisa estar no grupo docker e ser dono de /opt/medicano-staging).
[Unit]
Description=Medicano: deploy do staging (segue a main)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=marcos
ExecStart=/usr/local/bin/medicano-deploy staging
TimeoutStartSec=20min
