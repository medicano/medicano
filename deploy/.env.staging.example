# Modelo do .env do STAGING (copie para deploy/.env no clone do staging,
# permissão 600). Guia: deploy/README.md, seção 7. Nunca commitar.

# ---------- Docker Compose ----------
COMPOSE_PROJECT_NAME=medicano-staging
COMPOSE_FILE=compose.yml:compose.staging.yml
COMPOSE_PROFILES=db,tunnel
# Tag própria: sem ela o build do staging sobrescreve as imagens :latest da
# produção (e o front do staging tem outra URL de API embutida).
IMAGE_TAG=staging
# "production" de propósito: cookie Secure e o mesmo comportamento da produção.
NODE_ENV=production
# Front e API no mesmo endereço (ver web.staging.Caddyfile).
VITE_API_URL=https://medicano-staging.miotto.dev/api

# ---------- API ----------
MONGO_ROOT_USER=medicano
MONGO_ROOT_PASSWORD=gere-com-openssl-rand-hex-24
MONGODB_URI=mongodb://medicano:gere-com-openssl-rand-hex-24@mongo:27017/medicano-staging?authSource=admin
# Diferente do da produção: openssl rand -hex 32
JWT_SECRET=
# De preferência uma chave própria, num workspace com limite de gasto baixo.
ANTHROPIC_API_KEY=sk-ant-...
CORS_ORIGIN=https://medicano-staging.miotto.dev
# VAZIO e PRESENTE. Sem a linha, a API assume .medicano.app (NODE_ENV=production),
# o navegador recusa o cookie em miotto.dev e o login falha sem erro visível.
COOKIE_DOMAIN=

# E-mail desligado: só no log. Paciente de teste nunca recebe e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Medicano Staging <no-reply@medicano.app>

# ---------- Entrada ----------
# Token do túnel DO STAGING (outro túnel, não o da produção).
CLOUDFLARE_TUNNEL_TOKEN=
