# Caddy do staging: front e API no MESMO endereço (API em /api).
# Motivo: o staging fica atrás do Cloudflare Access, cujo cookie vale por
# hostname. Com a API em outro hostname, as chamadas do front não levariam o
# cookie do Access e seriam bloqueadas. Mesmo endereço = um login só e sem CORS.
# A produção continua com web.Caddyfile (embutido na imagem) e api.medicano.app.
# Montado por compose.staging.yml por cima do Caddyfile da imagem.
{
	admin off
	auto_https off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# /api/auth/login → api:3000/auth/login. Sem compressão aqui: o assistente
	# responde em streaming (text/event-stream) e não pode ficar em buffer.
	# O CF-Connecting-IP passa adiante intacto (limite de requisições por IP).
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		encode zstd gzip

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@notHashed not path /assets/*
		header @notHashed Cache-Control "no-cache"

		# SPA: rota desconhecida cai no index.html.
		try_files {path} /index.html
		file_server
	}
}
