# Copie para deploy/.env (permissão 600). Nunca commitar.

# ---------- Docker Compose ----------
# tunnel (Cloudflare, sem porta aberta) ou caddy (VPS com 80/443). Some "db"
# para usar um Mongo externo.
COMPOSE_PROFILES=db,tunnel
# Para um staging na mesma máquina: outra pasta/outro .env com
# COMPOSE_PROJECT_NAME=medicano-staging e NODE_ENV=staging.
COMPOSE_PROJECT_NAME=medicano
NODE_ENV=production
# Tag das imagens no GHCR (o CI publica latest e o SHA do commit).
IMAGE_TAG=latest
# Usado só quando a imagem do front é construída localmente (--build).
VITE_API_URL=https://api.medicano.app

# ---------- API ----------
# Mongo local (profile db): usuário/senha abaixo. Externo: cole a URI do Atlas.
MONGO_ROOT_USER=medicano
MONGO_ROOT_PASSWORD=gere-com-openssl-rand-hex-24
MONGODB_URI=mongodb://medicano:gere-com-openssl-rand-hex-24@mongo:27017/medicano?authSource=admin
# openssl rand -hex 32
JWT_SECRET=
ANTHROPIC_API_KEY=sk-ant-...
CORS_ORIGIN=https://medicano.app
COOKIE_DOMAIN=.medicano.app

# E-mail por SMTP (qualquer provedor). Vazio = só registra no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Medicano <no-reply@medicano.app>

# ---------- Entrada ----------
# profile tunnel: token do túnel (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# profile caddy
WEB_DOMAIN=medicano.app
API_DOMAIN=api.medicano.app
ACME_EMAIL=
